{
    "name": "examples-shared",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        "./theme.css": "./src/theme/theme.css",
        "./themes": "./src/themes/themes.ts",
        "./themes/*.css": "./src/themes/*.css",
        "./recipes/*": "./src/recipes/*.ts",
        "./framework": "./src/framework.ts",
        "./meta-types": "./src/meta-types.ts",
        "./embed/*": "./src/embed/*.ts",
        "./scripts/*": "./scripts/*.ts",
        "./e2e/*": "./e2e/*.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@playwright/test": "1.65.1",
        "@types/node": "26.6.6",
        "jsdom": "31.0.1",
        "typescript": "7.0.2",
        "vitest": "5.1.0"
    }
}
