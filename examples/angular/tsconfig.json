{
    // TypeScript 6.0.3, pinned in this app only: the Angular compiler (ngc, the Analog Vite plugin)
    // supports `typescript >=6.0 <6.1` (as fixtures/angular). The package's sources compile with
    // the app in dev (the `@fragiola/source` condition), so they are part of the program; the
    // build bundles the package's dist.
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "types": ["node", "vite/client"],
        "allowImportingTsExtensions": true,
        "useDefineForClassFields": false
    },
    "angularCompilerOptions": {
        "strictTemplates": true,
        "strictInjectionParameters": true,
        "strictInputAccessModifiers": true,
        "strictStandalone": true,
        "typeCheckHostBindings": true,
        "extendedDiagnostics": {
            "defaultCategory": "error"
        }
    },
    "include": [
        "src/**/*.ts",
        "../../packages/angular/src/**/*.ts",
        "../../packages/angular/internal/**/*.ts",
        "../../packages/angular/dialog/**/*.ts",
        "../../packages/angular/tabs/**/*.ts",
        "tests",
        "*.config.ts",
        "vite.shared.ts"
    ]
}
