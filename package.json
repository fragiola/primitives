{
    "name": "primitives",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "packageManager": "pnpm@12.21.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "check": "biome check && pnpm check:layout",
        "check:fix": "biome check --write",
        "check:layout": "node scripts/check-layout.ts",
        "typecheck": "pnpm -r --if-present typecheck",
        "test": "vitest run",
        "build": "pnpm -r --if-present build && node scripts/check-dts.ts",
        "changeset": "changeset",
        "release:version": "changeset version",
        "conformance": "pnpm --filter conformance e2e",
        "e2e": "pnpm conformance && pnpm --workspace-concurrency=1 --filter \"./examples/*\" --if-present e2e",
        "dev": "node scripts/dev-fixtures.ts"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@biomejs/biome": "2.6.7",
        "@changesets/changelog-github": "1.0.1",
        "@changesets/cli": "3.0.3",
        "publint": "0.3.25",
        "vitest": "5.1.0"
    }
}
